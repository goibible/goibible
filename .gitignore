__pycache__/
*.pyc
*.bak
*.bak_*
*.bak-*
.~lock*
.env
.env.*

# Compiled SQLite binaries are rebuilt from Meta_Bible_Data/sqlite/schema.sql
# + reference_seed.sql + versions/*.sql via Meta_Bible_Data/sqlite/build_shell.sh
# and Meta_Bible_Data/sqlite/assemble.sh.
# Do not commit generated databases; commit the .sql source instead.
*.db
*.sqlite3
*.sqlite
*.apk
*.keystore

# The one tracked exception is a small import-ready shell with schema/reference
# data but no Bible verse rows.
!Meta_Bible_Data/sqlite/goi_bible_shell.db

goi_bible_downloads/
Meta_Bible_Data/staging/tmp/

# App-facing downloadable Bible databases. These are intentionally committed so
# Android/desktop clients can fetch import-ready edition DBs from GitHub.
!Meta_Bible_Data/goi_db_download/
!Meta_Bible_Data/goi_db_download/*.db
!Meta_Bible_Data/goi_db_download/*.json
!Meta_Bible_Data/goi_db_download/*.md
!Meta_Bible_Data/goi_db_download/*.py

# Generated video and audio artifacts
Apps/bible_video/output/
Apps/bible_video/work/
Apps/bible_video/*.log
Apps/bible_video/vendor/kokoro/voice_samples/
Apps/proverbs_video/output/
Apps/proverbs_video/work/
Apps/proverbs_video/*.log

# Local run and translation logs
/logs/

# SQLite transient files and local build copies
*.sqlite3-shm
*.sqlite3-wal
Meta_Bible_Data/local_backups/
Meta_Bible_Data/sqlite/editions/
Meta_Bible_Data/sqlite/shell.sqlite3
Meta_Bible_Data/staging/**/*.sqlite3
Meta_Bible_Data/archive/*.sqlite3
Meta_Bible_Data/archive/BCP47/
Meta_Bible_Data/sqlite/versions/*.sql.bak-*

# Packaged archives and local mobile/desktop build artifacts
/iphone_package.zip
Apps/GOIBible_android/app/src/main/assets/*.db
Apps/GOIBible_android/dist/
Apps/GOIBible_desktop/**/resources/*.db
