__pycache__/
*.pyc
*.bak
*.bak_*
*.bak-*
.~lock*
.env
.env.*

# Compiled SQLite binaries are rebuilt from sqlite/schema.sql + reference_seed.sql
# + versions/*.sql via sqlite/build_shell.sh and sqlite/assemble.sh.
# Do not commit generated databases; commit the .sql source instead.
*.db
*.sqlite3
*.sqlite
*.apk

# The one tracked exception is a small import-ready shell with schema/reference
# data but no Bible verse rows.
!sqlite/goi_bible_shell.db

sqlite/editions/
goi_bible_downloads/

# App-facing downloadable Bible databases. These are intentionally committed so
# Android/desktop clients can fetch import-ready edition DBs from GitHub.
!goi_db_download/
!goi_db_download/*.db
!goi_db_download/*.json
!goi_db_download/*.md
!goi_db_download/*.py
